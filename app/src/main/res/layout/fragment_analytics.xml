<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:scrollbars="none"
    android:overScrollMode="never"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:text="DISCIPLINE SCORE"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/cuckoo_on_surface_muted"
            android:letterSpacing="0.1"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/textDisciplineScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="@color/cuckoo_success"
            android:layout_marginBottom="32dp"/>

        <com.cuckoo.app.DonutChartView
            android:id="@+id/donutChart"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/textTotalScreenTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="@color/cuckoo_on_background"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnGrantUsage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant Screen Time Permission"
            android:backgroundTint="@color/cuckoo_info"
            android:visibility="gone"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:text="TASK COMPLETION"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/cuckoo_on_surface_muted"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAnalytics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:text="SCREEN TIME"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/cuckoo_on_surface_muted"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerScreenTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

    </LinearLayout>
</ScrollView>
