<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="APP FREEZING"
        android:textSize="11sp"
        android:textColor="@color/cuckoo_on_surface_muted"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cuckoo needs Accessibility access to freeze other apps while a task is active."
        android:textSize="14sp"
        android:textColor="@color/cuckoo_on_surface_secondary"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEnableAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Accessibility Service"
        android:backgroundTint="@color/cuckoo_primary"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/textAccessibilityStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/cuckoo_error"
        android:text="Currently disabled"/>

</LinearLayout>
