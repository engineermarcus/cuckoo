<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="?attr/android:colorBackground">

    <TextView
        android:id="@+id/textReviewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="?attr/colorOnBackground"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/textCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceSecondary"
        android:layout_marginBottom="40dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMarkDone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Yes, I completed it"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        app:icon="@drawable/ic_check"
        app:iconTint="@android:color/white"
        app:iconGravity="textStart"
        android:backgroundTint="?attr/colorSuccess"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMarkMissed"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="I didn't finish it"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        app:icon="@drawable/ic_close"
        app:iconTint="@android:color/white"
        app:iconGravity="textStart"
        android:backgroundTint="?attr/colorError"/>

</LinearLayout>
